{
  "name": "scran-data",
  "private": true,
  "description": "Scran's nutrition data: checks it, builds the app's data bundle and the website, and publishes both to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "validate-schema": "node scripts/validate-schema.ts examples examples/bundle/manifest.json",
    "validate": "node scripts/validate.ts examples",
    "validate-data": "node scripts/validate-schema.ts data && node scripts/validate.ts data --release",
    "bundle": "node scripts/build-bundle.ts data public/data/v1 --release",
    "site": "node scripts/build-site.ts data public",
    "example-bundle": "node scripts/build-bundle.ts examples examples/bundle --now 2026-10-11T12:00:00Z",
    "golden": "node scripts/golden.ts",
    "bench": "node scripts/bench.ts",
    "pdf-extract": "node scripts/pdf-extract.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
